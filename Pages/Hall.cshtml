@page
@using RestaurantOrderSystem.Models
@model RestaurantOrderSystem.Pages.HallModel


<link rel="stylesheet" href="~/css/hall.css" />

<div class="hall-layout">
    @if (User.IsInRole("Admin"))
    {
        <aside class="hall-controls">

            <details class="control-box">
                <summary>Create Table</summary>
                <form method="post" asp-page-handler="AddTable">
                    @Html.AntiForgeryToken()
                    <label>Row</label>
                    <input type="number" name="row" />

                    <label>Column</label>
                    <input type="number" name="col" />

                    <label>Number</label>
                    <input type="number" name="num" />

                    <button type="submit" class="btn">Add Table</button>
                </form>
            </details>

            <details class="control-box">
                <summary>Delete Table</summary>
                <form method="post" asp-page-handler="DeleteTable">
                    @Html.AntiForgeryToken()
                    <label>Row</label>
                    <input type="number" name="row" />

                    <label>Column</label>
                    <input type="number" name="col" />

                    <button type="submit" class="btn delete">Delete Table</button>
                </form>
            </details>

            <details class="control-box">
                <summary>Update Table</summary>
                <form method="post" asp-page-handler="UpdateTable">
                    @Html.AntiForgeryToken()

                    <label>Table ID</label>
                    <input type="number" name="id" />

                    <label>Row</label>
                    <input type="number" name="row" />

                    <label>Column</label>
                    <input type="number" name="col" />

                    <label>Number</label>
                    <input type="number" name="num" />

                    <button type="submit" class="btn update">Update</button>
                </form>
            </details>

        </aside>

    }
    

    <!-- RIGHT PANEL ----------------------------------------------------------->
    <main class="hall-grid">
        <h3>Table Layout</h3>

        <div class="grid-container">
            @for (int row = 0; row < 10; row++)
            {
                <div class="grid-row">
                    @for (int col = 0; col < 10; col++)
                    {
                        var hasTable = Model.Tables.Any(t => t.Row == row && t.Col == col);

                        <div class="grid-cell" data-row="@row" data-col="@col">
                            @if (hasTable)
                            {
                                var table = Model.Tables.First(t => t.Row == row && t.Col == col);
                                <div class="table-cell" title="Table @table.Number (ID: @table.Id)">
                                    <a class="table-link" asp-page="Table" asp-route-id="@table.Id">
                                        @table.Number
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="empty-cell"></div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </main>

</div>
