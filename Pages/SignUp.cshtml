@page
@using RestaurantOrderSystem.Models
@model RestaurantOrderSystem.Pages.SignUpModel
@{
    ViewData["Title"] = "Sign Up";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h2 class="text-center">Sign Up</h2>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }

                  @*   <!-- Google OAuth Sign Up Option -->
                    @if (!Model.IsGoogleSignUp)
                    {
                        <div class="text-center mb-4">
                            <p>Sign up with:</p>
                            <form method="post" asp-page="/Login" asp-page-handler="Google">
                                <button type="submit" class="btn btn-outline-danger btn-lg">
                                    Sign up with Google
                                </button>
                            </form>
                        </div>
                        <hr />
                        <p class="text-center">Or create a local account:</p>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <p>You're signing up with Google. Please choose a username to complete registration.</p>
                        </div>
                    } *@

                    <!-- Sign Up Form -->
                    <form method="post">
                        @if (Model.IsGoogleSignUp)
                        {
                            <input asp-for="NewUser.Email" type="hidden" />
                            <div class="form-group mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" value="@Model.NewUser.Email" readonly />
                                <small class="form-text text-muted">This email is from your Google account.</small>
                            </div>
                        }
                        else
                        {
                            <div class="form-group mb-3">
                                <label asp-for="NewUser.Email" class="form-label">Email *</label>
                                <input asp-for="NewUser.Email" type="email" class="form-control" />
                                <span asp-validation-for="NewUser.Email" class="text-danger"></span>
                            </div>
                        }

                        <div class="form-group mb-3">
                            <label asp-for="NewUser.Username" class="form-label">Username *</label>
                            <input asp-for="NewUser.Username" class="form-control" />
                            <span asp-validation-for="NewUser.Username" class="text-danger"></span>
                        </div>

                        <!-- Password fields only for traditional sign-up -->
                        @if (!Model.IsGoogleSignUp)
                        {
                            <div class="form-group mb-3">
                                <label asp-for="NewUser.Password" class="form-label">Password *</label>
                                <input asp-for="NewUser.Password" type="password" class="form-control" />
                                <span asp-validation-for="NewUser.Password" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="ConfirmPassword" class="form-label">Confirm Password *</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" />
                                <span class="text-danger">
                                    @Html.ValidationMessage("ConfirmPassword")
                                </span>
                            </div>
                        }

                        <div class="form-group mb-3">
                            <label asp-for="NewUser.Role" class="form-label">Account Type</label>
                            <select asp-for="NewUser.Role" class="form-control">
                                <option value="">-- Select Role --</option>
                                <option value="@Role.Admin">Admin</option>
                                <option value="@Role.Waiter">Waiter</option>
                                <option value="@Role.Cook">Cook</option>
                            </select>
                            <small class="form-text text-muted">Choose the role that matches how you'll use the system.</small>
                            <span asp-validation-for="NewUser.Role" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Create Account</button>
                    </form>

                    <div class="text-center mt-3">
                        <p>Already have an account? <a href="/Login">Log in here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}