@page
@using RestaurantOrderSystem.Models
@model RestaurantOrderSystem.Pages.ItemModel

<div class="container mt-4">
    <h2 class="blue-text"><i class="bi bi-gear"></i> Item Management</h2>
    <button class="btn btn-info mb-3" data-bs-toggle="modal" data-bs-target="#infoModal">
        <i class="bi bi-info-circle"></i> Page Info
    </button>

    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="m-0 blue-text">Add Item</h5>
                </div>
                <div class="card-body management">
                    <form method="post" asp-page-handler="AddItem">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input name="name" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Price</label>
                            <input name="price" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-circle"></i>  Add Item </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="blue-text">Delete Item</h5>
                </div>
                <div class="card-body management">
                    <form method="post" asp-page-handler="DeleteItem">
                        <div class="mb-3">
                            <label class="form-label">Item ID</label>
                            <input type="number" name="id" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-danger w-100"> <i class="bi bi-trash me-1"></i> Delete Item</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="blue-text">Update Item</h5>
                </div>
                <div class="card-body management">
                    <form method="post" asp-page-handler="UpdateItem">
                        <div class="mb-3">
                            <label class="form-label">Item ID</label>
                            <input type="number" name="id" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input name="name" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Price</label>
                            <input name="price" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100"> <i class="bi bi-pencil-square me-1"></i> Update Item</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h5 class="blue-text">Items</h5>
        </div>
        <div class="card-body">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="blue-text">
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Name</td>
                                    <td>@item.Price</td>
                                    <td>
                                        <form method="post" asp-page-handler="DeleteItem">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No items yet.</p>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="infoModal" tabindex="-1" aria-labelledby="infoModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="infoModalLabel">Item Management Information</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p>
                    In this page, you can create, edit, and delete menu items.
                    All added items become available for waiters when creating customer orders.
                </p>
                <ul>
                    <li><strong>Add Item</strong> – Creates a new item by entering its name and price.</li>
                    <li><strong>Delete Item</strong> – Removes an existing item using its ID.</li>
                    <li><strong>Update Item</strong> – Updates the item's name or price using its ID.</li>
                </ul>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>