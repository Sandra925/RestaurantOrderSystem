@page
@using RestaurantOrderSystem.Models
@model RestaurantOrderSystem.Pages.OrderModel
@{
    ViewData["Title"] = "Order Management";
}

<div class="container">
    <h2>Order Management</h2>

    @if (Model.Order != null)
    {
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5>Order Information</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Order ID:</strong> @Model.Order.Id</p>
                        <p><strong>Table ID:</strong> @Model.Order.TableId</p>
                        <p><strong>Customer Count:</strong> @Model.Order.CustomerCount</p>
                        <p><strong>Status:</strong> @Model.Order.Status</p>
                        <p><strong>Created:</strong> @Model.Order.CreatedAt.ToString("MM/dd/yyyy")</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <h5 style="margin: 0;">Payment</h5>
                            @{
                                var paymentStatusClass = Model.Order.PaymentStatus == PaymentStatus.Paid ? "badge-success" : "badge-warning";
                                var paymentStatusText = Model.Order.PaymentStatus == PaymentStatus.Paid ? "Paid" : "Unpaid";
                            }
                            <span class="badge @paymentStatusClass" style="font-size: 0.9rem; padding: 6px 12px;">@paymentStatusText</span>
                        </div>
                    </div>
                    <div class="card-body">
                        @{
                            var hasItems = Model.OrderItems != null && Model.OrderItems.Any();
                            var orderTotal = hasItems ? Model.OrderItems.Sum(oi => oi.Quantity * (oi.Item?.Price ?? 0)) : 0;
                        }
                        @if (Model.Order.PaymentStatus == PaymentStatus.Unpaid)
                        {
                            @if (hasItems)
                            {
                                <p><strong>Total Amount:</strong> @orderTotal.ToString("C")</p>
                                @if (Model.Order.Status == OrderStatus.Ready || Model.Order.Status == OrderStatus.Open)
                                {
                                    <a asp-page="/Payment" asp-route-orderId="@Model.Order.Id" asp-route-tableId="@Model.Order.TableId" class="btn btn-warning" style="margin-top: 10px;">Process Payment</a>
                                }
                                else
                                {
                                    <div class="alert alert-info" role="alert">
                                        Waiting for kitchen to complete the order...
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-warning" role="alert">
                                    <strong>No items in order</strong><br>
                                    Add items to the order before processing payment.
                                </div>
                            }
                        }
                        else if (Model.Order.PaymentStatus == PaymentStatus.Paid)
                        {
                            <div class="alert alert-success" role="alert">
                                <strong>Payment Complete</strong><br>
                                Paid via @Model.Order.PaymentMethod on @Model.Order.PaidAt?.ToString("g")
                            </div>
                        }
                    </div>
                </div>
            </div>
         
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5>Available Items</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>ID</th>
                                            <th>Name</th>
                                            <th>Price</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Items)
                                        {
                                            <tr>
                                                <td>@item.Id</td>
                                                <td>@item.Name</td>
                                                <td>@item.Price</td>
                                                <td>
                                                    <form method="post" asp-page-handler="AddItemsToOrder">
                                                        <input type="hidden" name="itemID" value="@item.Id" />
                                                        <input type="hidden" name="orderID" value="@Model.Order.Id" />
                                                        <input type="hidden" name="tableID" value="@Model.Order.TableId" />
                                                        <button type="submit" class="btn btn-success btn-sm">+ Add</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No available items found.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5>Current Order Items</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.OrderItems != null && Model.OrderItems.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Item</th>
                                            <th>Quantity</th>
                                            <th>Price</th>
                                            <th>Total</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var orderItem in Model.OrderItems)
                                        {
                                            <tr>
                                                <td>@orderItem.Item?.Name</td>
                                                <td>@orderItem.Quantity</td>
                                                <td>@orderItem.Item?.Price</td>
                                                <td>@((orderItem.Quantity * (orderItem.Item?.Price ?? 0)))</td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <form method="post" asp-page-handler="UpdateOrderItem" class="d-inline">
                                                            <input type="hidden" name="orderItemId" value="@orderItem.Id" />
                                                            <input type="hidden" name="orderId" value="@Model.Order.Id" />
                                                            <input type="hidden" name="tableId" value="@Model.Order.TableId" />
                                                            <input type="hidden" name="quantity" value="@(orderItem.Quantity + 1)" />
                                                            <button type="submit" class="btn btn-outline-primary">+1</button>
                                                        </form>
                                                        <form method="post" asp-page-handler="RemoveItemFromOrder" class="d-inline">
                                                            <input type="hidden" name="orderItemId" value="@orderItem.Id" />
                                                            <input type="hidden" name="orderId" value="@Model.Order.Id" />
                                                            <input type="hidden" name="tableId" value="@Model.Order.TableId" />
                                                            <button type="submit" class="btn btn-outline-danger">Remove</button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="table-active">
                                            <td colspan="3"><strong>Total:</strong></td>
                                            <td colspan="2"><strong>@Model.OrderItems.Sum(oi => oi.Quantity * (oi.Item?.Price ?? 0)).ToString("C")</strong></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No items in this order yet.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            Order not found or could not be loaded.
        </div>
    }
</div>